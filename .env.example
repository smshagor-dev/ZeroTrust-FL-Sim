ZTFL_LOG_LEVEL=info
ZTFL_LISTEN_ADDRESS=127.0.0.1:50051

ZTFL_SERVER_CERT=certs/dev/server.crt
ZTFL_SERVER_KEY=certs/dev/server.key
ZTFL_CLIENT_CA=certs/dev/ca.crt
ZTFL_JWT_PUBLIC_KEY=certs/dev/jwt_signing_public.pem
ZTFL_TRUST_DOMAIN=zerotrust-fl.local

ZTFL_TOKEN_ISSUER=zerotrust-fl-sim
ZTFL_TOKEN_AUDIENCE=zerotrust-fl-services
ZTFL_REGISTRATION_LEASE=5m
ZTFL_MAX_MESSAGE_BYTES=67108864

ZTFL_RANDOM_SEED=42
