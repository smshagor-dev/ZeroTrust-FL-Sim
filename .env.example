ZTFL_LOG_LEVEL=info
ZTFL_LISTEN_ADDRESS=127.0.0.1:50051

# Development PKI. Use externally provisioned workload identities outside local development.
ZTFL_CERTIFICATE_ALGORITHM=ecdsa-p256
ZTFL_SERVER_CERT=certs/dev/server.crt
ZTFL_SERVER_KEY=certs/dev/server.key
ZTFL_CLIENT_CA=certs/dev/ca.crt
ZTFL_JWT_PUBLIC_KEY=certs/dev/jwt_signing_public.pem
ZTFL_TRUST_DOMAIN=zerotrust-fl.local

ZTFL_TOKEN_ISSUER=zerotrust-fl-sim
ZTFL_TOKEN_AUDIENCE=zerotrust-fl-services
ZTFL_REGISTRATION_LEASE=5m
ZTFL_MAX_MESSAGE_BYTES=8388608
ZTFL_MIN_UPDATES=3
ZTFL_MAX_UPDATES_PER_MINUTE=12
ZTFL_AGGREGATION_METHOD=median
ZTFL_TRIM_RATIO=0.2
ZTFL_PQC_MODE=prefer
ZTFL_PQC_REQUIRE_IDENTITY=false

# Immutable identity for durable experiment state. Reusing a state backend with a
# different experiment ID or configuration digest fails closed. If the full digest
# is empty, the coordinator fingerprints its own recovery-critical policy only.
# For reproducible experiments, supply a SHA-256 of the canonical complete experiment
# configuration including dataset/partition, seeds, privacy and attack settings.
ZTFL_EXPERIMENT_ID=default
ZTFL_EXPERIMENT_CONFIG_SHA256=

# Durable coordinator state backends are mutually exclusive.
# Filesystem is the local reference backend. Empty both values for volatile mode.
ZTFL_STATE_FILE=data/coordinator-state.json
# PostgreSQL mode: clear ZTFL_STATE_FILE and set a DSN. Use TLS/credential injection
# appropriate to the deployment; the example remains empty intentionally.
ZTFL_POSTGRES_DSN=
# docker-compose.postgres.yml also requires these local-development settings.
ZTFL_POSTGRES_USER=ztfl
ZTFL_POSTGRES_DB=zerotrust_fl
ZTFL_POSTGRES_PASSWORD=

# Optional S3-compatible model artifact separation. This requires PostgreSQL mode.
# Production endpoints should use HTTPS. Plain HTTP is rejected unless the explicit
# insecure opt-in is enabled for an isolated local/test object store.
ZTFL_S3_ENDPOINT=
ZTFL_S3_BUCKET=
ZTFL_S3_PREFIX=models
ZTFL_S3_REGION=us-east-1
ZTFL_S3_ALLOW_INSECURE_HTTP=false
ZTFL_S3_FORCE_PATH_STYLE=false
# Keep credentials outside source control. The coordinator also accepts the standard
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, and AWS_SESSION_TOKEN environment variables.
ZTFL_S3_ACCESS_KEY_ID=
ZTFL_S3_SECRET_ACCESS_KEY=
ZTFL_S3_SESSION_TOKEN=

# Loopback/secure-by-default observability. Override only on an explicitly trusted network.
ZTFL_TELEMETRY_ENABLED=false
ZTFL_METRICS_ADDRESS=127.0.0.1:9464
ZTFL_METRICS_HOST=127.0.0.1
ZTFL_METRICS_PORT=9465
ZTFL_OTEL_ENDPOINT=
ZTFL_OTEL_INSECURE=false
ZTFL_TELEMETRY_INSTANCE=coordinator

ZTFL_COLLUSION_SCALE=8
ZTFL_COLLUSION_SEED=20271
ZTFL_OBSERVABILITY_ROUNDS=1000
ZTFL_GRAFANA_ADMIN_PASSWORD=ztfl-local-dev-change-me

# Dashboard POST control is disabled when this value is empty.
ZTFL_DASHBOARD_CONTROL_TOKEN=

ZTFL_RANDOM_SEED=42
