FROM golang:1.27-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/ztfl-recovery ./cmd/ztfl-recovery

FROM postgres:18.6-alpine

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && rm -f /usr/local/bin/gosu \
    && mkdir -p /recovery \
    && chown postgres:postgres /recovery

COPY --from=builder /out/ztfl-recovery /usr/local/bin/ztfl-recovery

USER postgres
WORKDIR /recovery
ENTRYPOINT ["/usr/local/bin/ztfl-recovery"]
