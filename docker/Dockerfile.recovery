FROM golang:1.27-alpine AS builder

RUN apk add --no-cache protobuf
WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 \
    && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2 \
    && protoc \
        --go_out=. --go_opt=module=github.com/smshagor-dev/ZeroTrust-FL-Sim \
        --go-grpc_out=. --go-grpc_opt=module=github.com/smshagor-dev/ZeroTrust-FL-Sim \
        proto/fl_service.proto \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ztfl-recovery ./cmd/recovery

# The runtime intentionally inherits pg_dump/pg_restore from the exact
# PostgreSQL reference image used by the v0.6 Docker/CI profile.
FROM postgres:18.6-alpine

RUN apk add --no-cache ca-certificates \
    && mkdir -p /recovery \
    && chown postgres:postgres /recovery

COPY --from=builder /out/ztfl-recovery /usr/local/bin/ztfl-recovery

USER postgres
WORKDIR /recovery
ENTRYPOINT ["/usr/local/bin/ztfl-recovery"]
