FROM golang:1.27-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/coordinator ./cmd/coordinator

FROM golang:1.27-alpine AS health-probe-builder
ARG GRPC_HEALTH_PROBE_COMMIT=82e04432a7344c01c56406a6ddf5c8b6841d5a65
RUN CGO_ENABLED=0 go install github.com/grpc-ecosystem/grpc-health-probe@${GRPC_HEALTH_PROBE_COMMIT}

FROM alpine:3.24 AS runtime

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && addgroup -S -g 10001 ztfl \
    && adduser -S -D -H -u 10001 -G ztfl ztfl \
    && mkdir -p /app/data \
    && chown -R 10001:10001 /app

WORKDIR /app
COPY --from=builder --chown=10001:10001 /out/coordinator /app/coordinator
COPY --from=health-probe-builder /go/bin/grpc-health-probe /usr/local/bin/grpc_health_probe

USER 10001:10001
EXPOSE 50051 9090
ENTRYPOINT ["/app/coordinator"]
